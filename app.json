{
  "expo": {
    "name": "DraBornOdds",
    "slug": "dkd-drabornodds",
    "version": "0.7.4",
    "scheme": "dkd-drabornodds",
    "orientation": "portrait",
    "icon": "./assets/dkd-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07101D",
    "splash": {
      "image": "./assets/dkd-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101D"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.draborneagle.drabornodds",
      "versionCode": 1,
      "backgroundColor": "#07101D",
      "icon": "./assets/dkd-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/dkd-icon.png",
        "backgroundColor": "#061018"
      },
      "userInterfaceStyle": "dark"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "DraBornOdds",
      "backgroundColor": "#07101D"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/dkd-android-system-ui"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/DraBornOdds"
    },
    "extra": {
      "dkd_mode": "real_data",
      "dkd_version": "DKD_draborneagle_v0.7.4",
      "dkd_supabase_namespace": "dbo_",
      "dkd_privacy_url": "https://www.draborneagle.com/DraBornOdds/privacy",
      "dkd_terms_url": "https://www.draborneagle.com/DraBornOdds/terms",
      "dkd_data_safety_url": "https://www.draborneagle.com/DraBornOdds/data-safety",
      "dkd_support_url": "https://www.draborneagle.com/DraBornOdds/support",
      "dkd_apk_url": "https://www.draborneagle.com/DraBornOdds/App/"
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "translucent": true
    }
  }
}
